{
  "name": "moviemania",
  "version": "2.0.0",
  "private": true,
  "description": "Unified Next.js Live IPTV & VOD Cinema streaming platform",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:turbo": "next dev --turbo -p 3000",
    "warm": "node scripts/warm.mjs",
    "serve": "next build && next start -p 3000",
    "sync": "node scripts/sync.mjs",
    "sync:movies": "node scripts/sync.mjs --movies-only",
    "sync:series": "node scripts/sync.mjs --series-only",
    "sync:channels": "node scripts/sync.mjs --channels-only",
    "sync:all": "node scripts/sync.mjs --all",
    "health:check": "node scripts/health-check.mjs",
    "health:prune": "node scripts/health-check.mjs --prune",
    "health:fast": "node scripts/health-check.mjs --limit=100",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hls.js": "^1.5.14",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.428.0",
    "mongodb": "^6.8.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.3"
  }
}
