# MongoDB Connection URI (Docker container runs on port 27019)
MONGODB_URI=mongodb://localhost:27019/streamhub

# Redis Connection URL (Docker container runs on port 6389)
REDIS_URL=redis://localhost:6389

# VOD Cinema uses the free Cinemeta API (no API key required)
# Streaming playback powered by VidSrc (vidsrc.mov) using IMDb IDs

